# Personal Claude Code config (never share)
.claude/settings.local.json

# Runtime hook artifacts (per-session, regenerated)
.claude/memory/.session-signals
.claude/memory/.nudged-*

# Python
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# Frontend
web/node_modules/
web/.next/
web/.vercel/

# Claude worktrees (parallel session/subagent checkouts, never committed)
.claude/worktrees/
