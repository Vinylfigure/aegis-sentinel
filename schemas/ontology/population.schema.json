{
  "$defs": {
    "AssuranceState": {
      "description": "The assurance-state ladder. Coverage is never computed against a\ndenominator left of RATIFIED.",
      "enum": [
        "UNDEFINED",
        "DEFINED",
        "DISCOVERED",
        "RECONCILED",
        "RATIFIED",
        "STALE"
      ],
      "title": "AssuranceState",
      "type": "string"
    },
    "Delta": {
      "additionalProperties": false,
      "description": "A reconciliation difference as a first-class object with an owner\nand a disposition \u2014 never just a count.",
      "properties": {
        "bucket": {
          "$ref": "#/$defs/DeltaBucket"
        },
        "disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispositionRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "member_ref": {
          "minLength": 1,
          "title": "Member Ref",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        }
      },
      "required": [
        "bucket",
        "member_ref"
      ],
      "title": "Delta",
      "type": "object"
    },
    "DeltaBucket": {
      "description": "Set-based reconciliation buckets \u2014 counts are diagnostics, never\nevidence.",
      "enum": [
        "intersection",
        "left_only",
        "right_only",
        "conflict",
        "unresolvable",
        "excluded"
      ],
      "title": "DeltaBucket",
      "type": "string"
    },
    "DerivationRule": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "description",
        "sources"
      ],
      "title": "DerivationRule",
      "type": "object"
    },
    "DispositionRecord": {
      "additionalProperties": false,
      "description": "Nothing exits silently: NOT_APPLICABLE demands a rationale.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "value": {
          "$ref": "#/$defs/DispositionValue"
        }
      },
      "required": [
        "value",
        "owner"
      ],
      "title": "DispositionRecord",
      "type": "object"
    },
    "DispositionValue": {
      "description": "Every substrate answer resolves to one of these; nothing exits\nsilently \u2014 N/A demands a rationale (enforced on DispositionRecord).",
      "enum": [
        "implemented",
        "inherited",
        "shared",
        "vendor_managed",
        "compensating",
        "not_applicable"
      ],
      "title": "DispositionValue",
      "type": "string"
    },
    "PopulationType": {
      "enum": [
        "entity",
        "event",
        "relationship"
      ],
      "title": "PopulationType",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SourceRole"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "system",
        "role",
        "ref"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceRole": {
      "enum": [
        "authoritative",
        "contributing",
        "corroborating",
        "discovery",
        "exclusion"
      ],
      "title": "SourceRole",
      "type": "string"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Temporal semantics are part of evidence identity (invariant: no\nevidence without provenance and temporal semantics).",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Invariant: no population without a derivation rule (general case)\nor an authoritative source (degenerate case) \u2014 exactly one.",
  "properties": {
    "authoritative_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "definition": {
      "minLength": 1,
      "title": "Definition",
      "type": "string"
    },
    "deltas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Delta"
      },
      "title": "Deltas",
      "type": "array"
    },
    "derivation_rule": {
      "anyOf": [
        {
          "$ref": "#/$defs/DerivationRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exclusions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "period": {
      "$ref": "#/$defs/TimeWindow"
    },
    "size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size"
    },
    "state": {
      "$ref": "#/$defs/AssuranceState",
      "default": "UNDEFINED"
    },
    "type": {
      "$ref": "#/$defs/PopulationType"
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "definition",
    "period"
  ],
  "title": "Population",
  "type": "object"
}
